# Supabase credentials (required for cloud sync)
# Copy this file to .env and fill in your values
# Then run: flutter run --dart-define-from-file=.env

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Sentry DSN (optional — leave empty to disable crash reporting)
SENTRY_DSN=

# Google Sign-In native (Android).
# Web Client ID yang terdaftar di Supabase Auth → Google provider
# (Supabase Dashboard → Authentication → Providers → Google → Client ID).
# Digunakan sebagai serverClientId untuk menukar idToken ke Supabase
# tanpa membuka browser. Kosongkan untuk selalu pakai OAuth browser.
GOOGLE_WEB_CLIENT_ID=
