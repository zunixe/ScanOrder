default_platform(:android)

# AAB kini dibangun dengan flavor `play` → path output berubah.
# Build dulu dengan:
#   flutter build appbundle --release --flavor play --dart-define-from-file=.env
AAB_PATH = "build/app/outputs/bundle/playRelease/app-play-release.aab"

platform :android do
  desc "Upload existing AAB to Google Play production"
  lane :upload do
    upload_to_play_store(
      track: "production",
      aab: AAB_PATH,
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Upload to internal testing"
  lane :upload_internal do
    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
